# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# OpenAI (parser). Insert the real key into .env manually.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Shopify UCP (optional - fixture mode is used when unset)
SHOPIFY_CATALOG_CLIENT_ID=
SHOPIFY_CATALOG_CLIENT_SECRET=
SHOPIFY_FIXTURE_MODE=

# Public tunnel URL for in-thread app cards
PUBLIC_BASE_URL=http://localhost:3000
